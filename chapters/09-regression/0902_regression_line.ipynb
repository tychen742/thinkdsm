   "source": [
    "def correlation(t, label_x, label_y):\n",
    "    return np.mean(standard_units(t[label_x])*standard_units(t[label_y])).item()\n",
    "\n",
    "def slope(t, label_x, label_y):\n",
    "    r = correlation(t, label_x, label_y)\n",
    "    return r*np.std(t[label_y])/np.std(t[label_x]).item()\n",
    "\n",
    "def intercept(t, label_x, label_y):\n",
    "    return np.mean(t[label_y]) - slope(t, label_x, label_y)*np.mean(t[label_x]).item()"
   ]
  },
