    "x_data = baby['Maternal Height']\n",
    "\n",
    "y_data = baby['Maternal Pregnancy Weight']\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(4,4))\n",
    "\n",
    "m, b = np.polyfit(x_data, y_data, 1)\n",
    "\n",
    "minx, maxx = np.min(x_data),np.max(x_data)\n",
    "\n",
    "ax.plot([minx,maxx],[m*minx+b,m*maxx+b], label='Best Fit Line', color='red')\n",
    "\n",
    "ax.scatter(baby['Maternal Height'], \n",
    "           baby['Maternal Pregnancy Weight'],   \n",
    "           color='darkblue',\n",
    "           s=5\n",
