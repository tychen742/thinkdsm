    "plt.ylabel(y_label)\n",
    "plt.xlabel(x_label)\n",
    "ax.legend(bbox_to_anchor=(1.04,1), loc=\"upper left\", frameon=False)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
